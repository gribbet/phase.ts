  },
  "devDependencies": {
    "@gribbet/vite-config": "1.0.5",
    "typescript": "^7.0.2",
    "vite-plus": "1.1.0"
  },
  "peerDependencies": {
    "signaloits": "^2.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
