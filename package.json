{
  "name": "phase.ts",
  "version": "0.0.0-development",
  "description": "A lightweight reactive UI library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gribbet/phase.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
