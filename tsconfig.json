{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "paths": {
      "signals.ts": ["../signals.ts/src"]
    }
  },
  "include": ["src"]
}
